#!/usr/bin/env bash
# Reimu · an Arch Linux installer that asks the right questions and finishes the job.
#
#   reimu                       interactive
#   reimu --config FILE|URL     load a configuration, ask only for what is missing
#   reimu --config FILE --yes   unattended (passwords from REIMU_USER_PASSWORD / REIMU_ROOT_PASSWORD / REIMU_LUKS_PASSWORD)
#   reimu --dry-run             print every command instead of running it
#   reimu --save FILE           after the wizard, save the configuration and exit
#   reimu --resume              continue an installation that was interrupted
#   reimu --no-tmux             single pane, no live log on the side
set -Eeuo pipefail

REIMU_DIR="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")" && pwd)"
export REIMU_DIR

# shellcheck source=lib/core.sh
source "$REIMU_DIR/lib/core.sh"
for _lib in ui help state detect config wizard disk base boot system desktop software apply; do
  # shellcheck disable=SC1090
  source "$REIMU_DIR/lib/$_lib.sh"
done

usage() {
  sed -n '2,10p' "${BASH_SOURCE[0]}" | sed 's/^# \{0,1\}//'
  exit 0
}

CONFIG_SRC=""; SAVE_ONLY=""; RESUME=0; NO_TMUX="${REIMU_NO_TMUX:-0}"
ORIG_ARGS=("$@")

# The left column of the tmux layout: logo, then the phase list (never returns).
if [[ "${1:-}" == --side-pane ]]; then
  file="$2"
  while true; do
    printf '\033[H\033[2J'
    printf '\n  \e[38;5;196m\e[1m霊夢 Reimu\e[0m\n  \e[2mArch Linux installer v%s · experimental\e[0m\n\n' "$REIMU_VERSION"
    cat "$file" 2>/dev/null
    sleep 1
  done
fi
while (( $# )); do
  case "$1" in
    --config|-c) CONFIG_SRC="$2"; shift ;;
    --yes|-y) ASSUME_YES=1 ;;
    --dry-run|-n) DRY_RUN=1 ;;
    --save|-s) SAVE_ONLY="$2"; shift ;;
    --resume|-r) RESUME=1 ;;
    --no-tmux) NO_TMUX=1 ;;
    --version|-V) printf 'reimu %s\n' "$REIMU_VERSION"; exit 0 ;;
    --help|-h) usage ;;
    *) die "Unknown option: $1 (try --help)" ;;
  esac
  shift
done

trap 'err "Something went wrong at ${BASH_SOURCE[0]##*/}:$LINENO while running: $BASH_COMMAND"; err "Log: $REIMU_LOG"; disk_unmount' ERR

log_init
require_root

# Calamares-style layout: the installer on the left, the phase list and the
# live log on the right. Needs tmux (on the ISO) and a real terminal.
if ! (( NO_TMUX )) && ! (( DRY_RUN )) && [[ -z "${TMUX:-}" && -t 0 && -t 1 ]] && has tmux; then
  mkdir -p "$REIMU_RUN_DIR"
  printf '  Reimu\n\n  Answering the questions…\n' > "$REIMU_RUN_DIR/progress"
  : >> "$REIMU_LOG"
  self="$(readlink -f "${BASH_SOURCE[0]}")"
  child="REIMU_NO_TMUX=1 $(printf '%q ' "$self" "${ORIG_ARGS[@]}"); rc=\$?; printf '\\n  Reimu finished (exit %s). Press Enter to close this window.' \"\$rc\"; read -r _"
  tmux kill-session -t reimu 2>/dev/null || true
  cols="$(tput cols 2>/dev/null || echo 200)"; lines="$(tput lines 2>/dev/null || echo 50)"
  side=30; (( cols < 110 )) && side=24
  # Main pane: the installer. Left column: logo on top, phase list below. Bottom right: the live log.
  tmux new-session -d -s reimu -x "$cols" -y "$lines" "$child"
  tmux set-option -t reimu status-style "bg=colour196,fg=colour255" \; set-option -t reimu status-left " 霊夢 Reimu " \; set-option -t reimu status-right " Ctrl+b then arrows to move between panes " \; set-option -t reimu status-right-length 60 \; set-option -t reimu mouse on \; set-option -t reimu pane-border-style "fg=colour238" \; set-option -t reimu pane-active-border-style "fg=colour196"
  tmux split-window -t reimu:0.0 -h -b -l "$side" "$(printf '%q' "$self") --side-pane $REIMU_RUN_DIR/progress"
  tmux split-window -t reimu:0.1 -v -l 32% "printf '\\033[2m  live log · %s\\033[0m\\n' '$REIMU_LOG'; tail -F -n 200 '$REIMU_LOG'"
  tmux select-pane -t reimu:0.1
  exec tmux attach-session -t reimu
fi

banner
ui_init

if ! (( DRY_RUN )); then
  has pacstrap || die "pacstrap not found. Reimu runs from the Arch Linux live ISO."
  network_ok || die "No internet connection. Connect first (iwctl for Wi-Fi) and try again."
fi

detect_all
(( DRY_RUN )) || detect_geo
msg "Firmware $DETECT_FIRMWARE · CPU $DETECT_CPU · GPU $DETECT_GPU · RAM ${DETECT_RAM_MIB} MiB$( [[ "$DETECT_VIRT" != none ]] && printf ' · VM %s' "$DETECT_VIRT" )"

[[ -n "$CONFIG_SRC" ]] && config_load_any "$CONFIG_SRC"
config_defaults
config_normalize

# Passwords for unattended runs.
USER_PASSWORD="${REIMU_USER_PASSWORD:-}"
ROOT_PASSWORD="${REIMU_ROOT_PASSWORD:-}"
LUKS_PASSWORD="${REIMU_LUKS_PASSWORD:-}"

if [[ -n "$SAVE_ONLY" ]]; then
  REIMU_SAVE_PATH="$SAVE_ONLY"
  wizard
  config_save "$SAVE_ONLY"
  exit 0
fi

if (( RESUME )); then
  state_resume
  state_done disk || die "The disk phase never finished; start over without --resume."
  apply_summary
  apply_install
  exit 0
fi

if [[ -r "$(state_file)" ]] && ! (( ASSUME_YES )); then
  state_load "$(state_file)"
  if ask_yesno "An unfinished installation is mounted at $REIMU_MNT (done: ${STATE_DONE:-nothing}). Resume it?" y; then
    config_load "$REIMU_MNT$STATE_DIR_REL/reimu.conf"; config_defaults
    apply_summary
    apply_install
    exit 0
  fi
  STATE_DONE=""
fi

if (( ASSUME_YES )) && [[ -n "$CONFIG_SRC" ]]; then
  config_validate || die "The configuration is incomplete."
else
  wizard
fi

apply_summary
apply_confirm
apply_install
